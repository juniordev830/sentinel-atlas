# Chave de navegador para Maps JavaScript API + Places API (New), com referrers e cotas.
# Não use tokens administrativos aqui, não comite este arquivo depois de preenchido.
# Requer configuração e faturamento no Google Cloud; buscas de Places são sob demanda.
GOOGLE_MAPS_API_KEY=

# Copernicus Data Space / Sentinel Hub
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# AISStream (navios via WebSocket)
AISSTREAM_API_KEY=

# OpenSky (aeronaves; respeite licença e limites da API)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Fontes públicas sem credencial obrigatória
NASA_GIBS_BASE_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best
USGS_EARTHQUAKE_FEED=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
CELESTRAK_GP_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=json
CELESTRAK_STARLINK_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=starlink&FORMAT=json
SENTINEL_ALERT_WEBHOOK_URL=
SENTINEL_API_TOKEN=

# Fontes GeoINT opcionais: somente no ambiente local ou gerenciador de segredos.
# FIRMS MAP_KEY é gratuito mediante cadastro; limite de consultas do provedor.
FIRMS_MAP_KEY=
# Global Fishing Watch exige Bearer token e uso não comercial.
GFW_API_TOKEN=
# Feeds GeoJSON HTTPS de operadores regionais autorizados (FeatureCollection / Point).
# Estes endereços são lidos pelo servidor; configure apenas domínios confiáveis.
SENTINEL_TRANSIT_GEOJSON_URL=
SENTINEL_HYDRO_GEOJSON_URL=
SENTINEL_ALERTS_GEOJSON_URL=
